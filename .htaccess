# ปิด directory listing
Options -Indexes

# ปิด access ไฟล์อันตราย
<FilesMatch "^(\.env.*|.*\.sql|.*\.log|composer\..*)$">
    Require all denied
</FilesMatch>

# ปิด access โฟลเดอร์ backend/ และ .claude/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^backend/ - [F,L]
    RewriteRule ^\.claude/ - [F,L]

    # Transparently forward requests to frontend/ — URL ไม่เปลี่ยน
    RewriteCond %{REQUEST_URI} !frontend [NC]
    RewriteCond %{REQUEST_URI} !backend  [NC]
    RewriteRule ^(.*)$ frontend/$1 [L]
</IfModule>
